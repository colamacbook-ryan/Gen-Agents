{
  "name": "gen-agents",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "biome check . && node scripts/lint-rules.mjs",
    "lint:rules": "node scripts/lint-rules.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:sync": "bash scripts/db-sync.sh",
    "db:gen": "node packages/db/scripts/gen.ts",
    "db:test": "bash scripts/db-test.sh",
    "db:mutation": "python3 -B -I db/spec/mutate.py",
    "license:check": "node scripts/license-gate.mjs",
    "dev:dockerd": "bash scripts/dev-dockerd.sh",
    "docker:netcheck": "bash scripts/docker-netcheck.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
