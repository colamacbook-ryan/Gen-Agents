# .env.example — CHỈ tên biến, KHÔNG có giá trị thật (STD-04 §4, STD-06).
# Bản cài thật: install.sh tự sinh .env (0600) với khoá ngẫu nhiên; không ai phải điền tay.
# Bí mật vào container bằng TỆP (compose secrets, 0400), không bằng env của container (BUILD-PLAN §B.2, CNS-143).

# Khoá chủ bọc DEK của kho bí mật (AES-256-GCM envelope). Chỉ ga-app thấy. Không nằm trong backup.
GENAGENTS_MASTER_KEY=

# Khoá nội bộ — mỗi khoá chỉ đưa cho đúng hai bên dùng nó (BUILD-PLAN §B.2).
GA_SUPERVISOR_KEY=
GA_TERM_TICKET_KEY=
GA_UPDATER_KEY=
GA_EGRESS_KEY=

# Cổng edge (Caddy) mở ra host.
GA_PORT=7400

# --- Chỉ cho máy dev ---
# Đường dẫn checkout Second-Brain (nguồn thiết kế DB) cho `pnpm db:sync -- --rev <sha>`.
GA_SB_DIR=
