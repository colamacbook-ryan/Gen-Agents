{
  "_doc": "Ca kiểm adapter theo slug. Tệp *.txt/*.out/*.jsonl: output THẬT của Spike 1b (claude 2.1.299; đã thay id phiên, rút trường dài / đường dẫn). Ca có \"assumed\": dạng lỗi giả định (chưa kiểm, M6) — chuyển sang CLI giả chung (testing/fakes, L-FAKE) khi có.",
  "adapter": {
    "authAllowlist": [".claude/.credentials.json"],
    "nativeStatePaths": [".claude/projects", ".claude/history.jsonl", ".claude.json"],
    "outputSignals": {
      "phase": "stream",
      "certainty": "unmeasured"
    },
    "helpFile": "help.txt",
    "flagsObservedOutsideHelp": [],
    "loginArgvSubscriptionTail": ["auth", "login"],
    "systemPrompt": {
      "in": "argv",
      "flag": "--append-system-prompt"
    },
    "valueForm": "eq",
    "apiKeyFiles": [],
    "mcpConfigFile": "mcp.json",
    "checksumAlgorithm": "sha256",
    "selfUpdate": "unknown",
    "phaseAfterToolCall": "acting",
    "flagsAssumedNotInHelp": [],
    "toolRestriction": {
      "flags": ["--permission-mode", "--allowedTools", "--strict-mcp-config"],
      "argvContains": ["--permission-mode=dontAsk", "--allowedTools=mcp__ga", "--strict-mcp-config"]
    }
  },
  "streamFiles": [
    {
      "name": "lượt thật một câu (Spike 1b): model + delta + usage (có chi phí)",
      "file": "stream-ok.jsonl",
      "expected": [
        {
          "type": "model",
          "model": "claude-haiku-5-5"
        },
        {
          "type": "delta",
          "text": "ok"
        },
        {
          "type": "usage",
          "usage": {
            "input": 2,
            "output": 4,
            "cacheRead": 0,
            "cacheWrite": 33987,
            "thinking": 0,
            "costMicroUsd": 6800
          }
        }
      ]
    }
  ],
  "stream": [
    {
      "name": "text_delta (dạng Spike 1b) ⇒ delta",
      "line": "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Xin chào\"}},\"parent_tool_use_id\":null}",
      "expected": [
        {
          "type": "delta",
          "text": "Xin chào"
        }
      ]
    },
    {
      "name": "gọi công cụ (assumed CC-STREAM-01: content_block_start tool_use)",
      "line": "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"mcp__ga__recall\",\"input\":{}}},\"parent_tool_use_id\":null}",
      "expected": [
        {
          "type": "tool",
          "stage": "call",
          "name": "mcp__ga__recall",
          "callId": "toolu_1"
        }
      ]
    },
    {
      "name": "kết quả công cụ, parser không trạng thái ⇒ tên 'unknown' (assumed CC-STREAM-02)",
      "line": "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_1\",\"content\":\"x\"},{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_2\",\"content\":\"y\"}]},\"parent_tool_use_id\":null}",
      "expected": [
        {
          "type": "tool",
          "stage": "result",
          "name": "unknown",
          "callId": "toolu_1"
        },
        {
          "type": "tool",
          "stage": "result",
          "name": "unknown",
          "callId": "toolu_2"
        }
      ]
    },
    {
      "name": "delta của subagent bị bỏ",
      "line": "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"nội bộ\"}},\"parent_tool_use_id\":\"toolu_9\"}",
      "expected": []
    },
    {
      "name": "thinking_delta không phải văn bản trả lời",
      "line": "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"thinking_delta\",\"thinking\":\"...\"}},\"parent_tool_use_id\":null}",
      "expected": []
    },
    {
      "name": "dòng assistant lặp nội dung partial ⇒ bỏ (không nhân đôi)",
      "line": "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]},\"parent_tool_use_id\":null}",
      "expected": []
    },
    {
      "name": "rate_limit_event rejected ⇒ error (assumed CC-E02)",
      "line": "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"rejected\",\"resetsAt\":1792000000,\"rateLimitType\":\"five_hour\"}}",
      "expected": [
        {
          "type": "error",
          "code": "rate_limit_rejected",
          "message": "resetsAt=1792000000"
        }
      ]
    },
    {
      "name": "rate_limit_event allowed (Spike 1b) ⇒ không sự kiện",
      "line": "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"resetsAt\":1791975600,\"rateLimitType\":\"five_hour\"}}",
      "expected": []
    },
    {
      "name": "result lỗi ⇒ usage + error (assumed)",
      "line": "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"api_error_status\":429,\"result\":\"API Error: 429\",\"total_cost_usd\":0,\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0}}",
      "expected": [
        {
          "type": "usage",
          "usage": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0,
            "thinking": null,
            "costMicroUsd": 0
          }
        },
        {
          "type": "error",
          "code": "api_error_429",
          "message": "API Error: 429"
        }
      ]
    },
    {
      "name": "dòng không phải JSON",
      "line": "warning: something",
      "expected": []
    },
    {
      "name": "JSON mảng",
      "line": "[1,2,3]",
      "expected": []
    },
    {
      "name": "JSON hỏng",
      "line": "{\"type\":\"result\",",
      "expected": []
    },
    {
      "name": "system/status không mang thông tin",
      "line": "{\"type\":\"system\",\"subtype\":\"status\"}",
      "expected": []
    }
  ],
