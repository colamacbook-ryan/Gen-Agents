{
  "_doc": "Ca kiểm adapter theo slug. Tệp *.txt/*.out/*.err: output THẬT của Spike 1b (agy 1.3.5, chưa đăng nhập; đã rút URL OAuth, thay id). Ca có \"assumed\": dạng dựng theo REPORT / giả định — chuyển sang CLI giả chung (testing/fakes, L-FAKE) khi có. Tệp \"fake:<tên>\" = dữ liệu Spike 1b trong CLI giả chung (testing/fakes/<binary>/dumps/), không chép lại ở đây.",
  "adapter": {
    "authAllowlist": "unknown",
    "nativeStatePaths": [".gemini/antigravity-cli"],
    "outputSignals": {
      "phase": "stream",
      "certainty": "unmeasured"
    },
    "helpFile": "fake:help.txt",
    "flagsObservedOutsideHelp": ["--version", "--help"],
    "loginArgvSubscriptionTail": [],
    "systemPrompt": {
      "in": "file",
      "path": "GEMINI.md"
    },
    "valueForm": "split",
    "apiKeyFiles": ["home/.gemini/antigravity-cli/settings.json"],
    "mcpConfigFile": "home/.gemini/antigravity-cli/mcp_servers.json",
    "checksumAlgorithm": "sha512",
    "selfUpdate": "enabled",
    "phaseAfterToolCall": "acting",
    "_doc_stream": "stream-json theo schema thống nhất với CLI giả: testing/fakes ASSUMPTIONS AG-STREAM-1 (= AGY-STREAM-01) — giả định.",
    "flagsAssumedNotInHelp": ["--allowed-tools"],
    "toolRestriction": {
      "flags": ["--allowed-tools"],
      "argvContains": ["--allowed-tools", "mcp__ga"]
    }
  },
  "stream": [
