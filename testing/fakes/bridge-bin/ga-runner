#!/bin/sh
# GA-FAKES-TEST-ONLY — chỉ dùng trong test / image *-test, không bao giờ vào image phát hành.
# Cầu MCP giả (`ga-runner mcp-bridge …`) cho tới khi L-RT có cầu thật. Test tự đặt thư mục này lên PATH.
here="$(cd "$(dirname "$0")" && pwd)"
for n in "$(command -v node 2>/dev/null)" /usr/local/bin/node /usr/bin/node /opt/node22/bin/node; do
  if [ -n "$n" ] && [ -x "$n" ]; then exec "$n" "$here/../mcp-bridge.ts" "$@"; fi
done
echo "fake ga-runner: không tìm thấy node" >&2
exit 127
